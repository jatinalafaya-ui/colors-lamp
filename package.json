{
  "name": "colors-lamp",
  "version": "1.0.0",
  "private": true,
  "description": "Lint tooling for the COLORS LAMP application",
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "htmlhint \"public/**/*.html\"",
    "lint:css": "stylelint \"public/**/*.css\" --max-warnings 0",
    "lint:js": "eslint \"public/**/*.js\" --max-warnings 0"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "htmlhint": "1.9.2",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0"
  }
}
